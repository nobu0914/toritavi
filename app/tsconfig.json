{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // node --test が TypeScript を素で実行するために拡張子付きの相対 import を許す
    // （ESM は拡張子を要求する）。noEmit: true なので tsc の出力には影響しない。
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // workers/ は Cloudflare の Email Worker（別に wrangler で出す）。Next の
  // 型検査とビルドに入れない。サーバのテストが lib.ts を import するので、
  // その 1 ファイルだけは import 経由で検査される（Web 標準の API だけで書く）。
  "exclude": ["node_modules", "workers"]
}
